# Copia este archivo como .env (desarrollo) o .env.production (build del VPS)
# y rellena los valores. Vite solo expone las variables que empiezan por VITE_,
# y las lee al compilar: tras cambiarlas hay que volver a hacer `npx vite build`.

# URL del backend.
VITE_API_URL=https://api.inspira-legal.cloud

# Google Analytics 4: el «ID de medición» del flujo web, con formato G-XXXXXXXXXX
# (GA4 > Administrar > Flujos de datos > Web). Vacío = sin analítica.
# Solo carga si el visitante acepta la categoría «Analítica» en el banner de
# cookies (src/lib/analytics.js). La CSP de index.html ya permite Google.
# Eventos que se envían: page_view, whatsapp_clic, calendly_clic,
# calendly_reserva (solo con Calendly incrustado), begin_checkout,
# generate_lead, plan_enviado, diagnostico_completado y los de la app.
VITE_GA_ID=
