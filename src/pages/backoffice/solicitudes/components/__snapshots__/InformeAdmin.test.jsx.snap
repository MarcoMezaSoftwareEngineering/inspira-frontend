exports[`InformeAdmin — edición > buscar parecidos desde la cabecera entra a editar > parecidos 1`] = `
"<div class="space-y-0 -mx-5 -mt-4 overflow-hidden">
<div class="px-5 pt-4">
<div class="ex-h">
<span class="ex-h-ico">
<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M4 20V10M10 20V4M16 20v-7M22 20H2">
</path>
</svg>
</span>
<h3>Revisar el informe generado</h3>
<span class="ex-est" data-e="warn">
<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M4 20h4l11-11-4-4L4 16v4zM13 7l4 4">
</path>
</svg> Sin publicar</span>
</div>
<div class="ex-cuenta">
<div>
<b>37</b>
<span>compatibles</span>
</div>
<div>
<b>3</b>
<span>finalistas</span>
</div>
<div>
<b>2</b>
<span>extras</span>
</div>
<div>
<b>auto</b>
<span>lista</span>
</div>
<div>
<b>no</b>
<span>publicado</span>
</div>
</div>
<p class="ex-lead">El motor propone; usted decide. En cada máster: quitar, añadir, subir o bajar y una nota que el asesorado verá en su informe. Nada de esto se pierde al recalcular. Plan: <b>Paquete Full Económico</b>. Filtros: Andalucía, Madrid · Máx. 15.000 €.</p>
