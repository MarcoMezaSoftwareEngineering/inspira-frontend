exports[`InformeAdmin — vista > cargando, sin PDF y sin formulario 1`] = `
"<div class="space-y-0 -mx-5 -mt-4 overflow-hidden">
<div class="px-5 pt-4">
<div class="ex-h">
<span class="ex-h-ico">
<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M4 20V10M10 20V4M16 20v-7M22 20H2">
</path>
</svg>
</span>
<h3>Revisar el informe generado</h3>
<span class="ex-est" data-e="warn">
<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M4 20h4l11-11-4-4L4 16v4zM13 7l4 4">
</path>
</svg> Sin publicar</span>
</div>
<p class="ex-lead">El motor propone; usted decide. En cada máster: quitar, añadir, subir o bajar y una nota que el asesorado verá en su informe. Nada de esto se pierde al recalcular. Plan: <b>Plan contratado</b>.</p>
<div class="ex-fila">
<button type="button" disabled="" class="ex-btn sec" title="Vuelve a calcular con el formulario de hoy. La lista curada no se toca.">
<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zM12 11v5M12 8h.01">
</path>
</svg> Calculando…</button>
</div>
</div>
<div class="px-5 pt-4 pb-4 border-b border-neutral-100">
<div class="flex flex-wrap items-center justify-between gap-2">
<p class="text-xs text-neutral-400 italic">Aún no se ha subido un PDF de informe.</p>
<label class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg border border-neutral-300 bg-white hover:bg-neutral-50 cursor-pointer font-medium transition-all duration-200">
<svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
<path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12">
</path>
</svg>Subir / reemplazar PDF<input class="hidden" accept=".pdf,.doc,.docx,.xlsx,.xls,.ppt,.pptx" type="file">
</label>
</div>
</div>
<div class="px-5 pt-4 pb-5">
<div class="flex items-center justify-between gap-2 mb-4 flex-wrap">
<p class="ex-sub" style="margin: 0px;">Lista del informe</p>
<div class="flex gap-1.5 shrink-0">
</div>
</div>
<div class="mb-4">
<button class="flex items-center gap-1.5 text-[11px] font-semibold text-neutral-400 hover:text-neutral-600 transition-colors duration-150">
<svg class="w-3 h-3 transition-transform duration-200 " fill="currentColor" viewBox="0 0 20 20">
<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd">
</path>
</svg>Parámetros usados en el cálculo</button>
</div>
<div class="flex flex-col items-center gap-3 py-12">
<div class="w-8 h-8 border-2 border-[#1D6A4A] border-t-transparent rounded-full animate-spin">
</div>
<p class="text-xs text-neutral-400">Calculando compatibilidad…</p>
</div>
</div>
</div>"
`;

