<span class="ml-auto text-[11px] font-bold uppercase tracking-wide px-2 py-1
            rounded border bg-[#E8F5EE] text-[#14532d] border-[#1D6A4A]/35">avisada</span>
</div>
<div class="flex items-center gap-3 flex-wrap">
