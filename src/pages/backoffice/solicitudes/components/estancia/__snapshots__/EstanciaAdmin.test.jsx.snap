<div class="flex items-center gap-4 flex-wrap mt-3">
<label class="flex items-center gap-2 text-[12px] text-neutral-600">
<input class="accent-[#023A4B]" type="checkbox">Usa la dirección de la universidad</label>
<label class="flex items-center gap-2 text-[12px] text-neutral-600">
<span>Schengen 180 días</span>
<select class="text-[12px] border border-neutral-300 rounded-lg px-2.5 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-[#1D6A4A] focus:border-[#1D6A4A]">
<option value="">Sin preguntar</option>
<option value="si">Sí, ha viajado</option>
<option value="no">No</option>
</select>
</label>
</div>
<div class="flex items-center gap-2 mt-3.5 mb-1.5">
<p class="text-[11.5px] font-semibold text-neutral-600">Lo que nos ha contado</p>
<span class="flex-1 h-px bg-neutral-100">
</span>
</div>
<textarea rows="2" placeholder="Un NIE anterior, una estancia previa, cualquier cosa…" class="text-[12px] border border-neutral-300 rounded-lg px-2.5 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-[#1D6A4A] focus:border-[#1D6A4A] w-full">Tuvo un NIE de estudiante en 2019.</textarea>
<div class="flex items-center gap-2 mt-4 mb-2">
<p class="text-[11.5px] font-semibold text-neutral-600">Seguimiento en extranjería</p>
<span class="flex-1 h-px bg-neutral-100">
</span>
</div>
<div class="flex flex-wrap gap-2 items-end">
<label class="flex flex-col gap-1">
<span class="text-[11px] text-neutral-500">Nº expediente</span>
<input class="text-[12px] border border-neutral-300 rounded-lg px-2.5 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-[#1D6A4A] focus:border-[#1D6A4A] w-40" value="SA/123/2026">
</label>
<label class="flex flex-col gap-1">
<span class="text-[11px] text-neutral-500">Nº justificante</span>
<input class="text-[12px] border border-neutral-300 rounded-lg px-2.5 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-[#1D6A4A] focus:border-[#1D6A4A] w-36" value="I-2026-000123">
</label>
<label class="flex flex-col gap-1">
<span class="text-[11px] text-neutral-500">NIE</span>
<input class="text-[12px] border border-neutral-300 rounded-lg px-2.5 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-[#1D6A4A] focus:border-[#1D6A4A] w-32" value="Y1234567Z">
</label>
<label class="flex flex-col gap-1">
<span class="text-[11px] text-neutral-500">Fecha de ingreso</span>
<input class="text-[12px] border border-neutral-300 rounded-lg px-2.5 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-[#1D6A4A] focus:border-[#1D6A4A]" type="date" value="2026-09-20">
</label>
<label class="flex flex-col gap-1">
<span class="text-[11px] text-neutral-500">Estado en consulta</span>
<select class="text-[12px] border border-neutral-300 rounded-lg px-2.5 py-1.5 bg-white focus:outline-none focus:ring-1 focus:ring-[#1D6A4A] focus:border-[#1D6A4A] w-44">
<option value="">Sin consultar</option>
<option value="EN_TRAMITE">En trámite</option>
<option value="REQUERIDO">Requerimiento</option>
<option value="RESUELTO_FAVORABLE">Resuelto · favorable</option>
<option value="RESUELTO_DESFAVORABLE">Resuelto · desfavorable</option>
<option value="RECURSO">En recurso</option>
<option value="ARCHIVADO">Archivado</option>
</select>
<span class="text-[11px] text-neutral-500">Última consulta: 5/10/2026 · Carina Meza</span>
</label>
<div class="flex flex-col gap-1">
<span class="text-[11px] text-neutral-500">Año de nacimiento</span>
<span class="text-[12.5px] px-2.5 py-1.5 rounded-lg border bg-[#EEF2F8] border-[#1A3557]/20 text-[#1A3557] font-bold">1998</span>
</div>
</div>
<p class="text-[10.5px] text-neutral-400 mt-1.5">Son los cuatro datos con los que se consulta en la sede. El asesorado los ve en su portal.</p>"
`;

